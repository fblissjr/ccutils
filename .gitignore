.DS_Store
__pycache__
uv.lock
.playwright-mcp/
tests/__snapshots__/*
tmp/
claude-archive/
.claude/
internal/
coderef/
.path-privacy.local.json

# Local virtualenv
.venv/

# Tool data outputs -- real transcript data must NEVER be committed.
# These are the exact shapes run_v15_etl / the HTML+JSON exporters emit.
*.duckdb
*.duckdb.wal
*.parquet
parquet_lake/
# Raw Claude Code session logs are .jsonl -- ignore them everywhere and
# keep only the synthetic test fixture explicitly.
*.jsonl
!tests/sample_session.jsonl
# JSON star-schema export writes its data into dimensions/ + facts/ subdirs;
# ignore those wherever they land. The sibling meta.json holds only schema
# metadata + row counts (no transcript data), so it is deliberately NOT ignored
# here -- an unanchored `meta.json` would silently swallow unrelated files.
**/dimensions/
**/facts/
