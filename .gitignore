.DS_Store
__pycache__
.playwright-mcp/
tests/__snapshots__/*
tmp/
claude-archive/
# Keep .claude/ local (settings, caches) EXCEPT the checked-in project skills.
.claude/*
!.claude/skills/
internal/
coderef/
.path-privacy.local.json
scratch/

# Local virtualenv
.venv/

# Tool data outputs -- real transcript data must NEVER be committed.
# These are the exact shapes run_v15_etl / the HTML+JSON exporters emit.
*.duckdb
*.duckdb.wal
*.parquet
parquet_lake/
# Raw Claude Code session logs are .jsonl -- ignore them everywhere and
# keep only the synthetic test fixture explicitly.
*.jsonl
!tests/sample_session.jsonl
# JSON star-schema export writes its data into dimensions/ + facts/ subdirs;
# ignore those wherever they land. The sibling meta.json holds only schema
# metadata + row counts (no transcript data), so it is deliberately NOT ignored
# here -- an unanchored `meta.json` would silently swallow unrelated files.
**/dimensions/
**/facts/

# Rendered transcripts are the HIGHEST-fidelity private artifact this tool
# emits -- full session text, formatted for reading, in a format meant for
# sharing. The type rules above cover .duckdb/.parquet/.jsonl but nothing
# covered HTML, so `ccutils -o out/` inside the repo produced a directory of
# real transcripts that was untracked but NOT ignored -- one `git add -A`
# from being committed. Ignore HTML everywhere; the Jinja templates are the
# only tracked HTML and are whitelisted explicitly.
*.html
!src/ccutils/templates/*.html
# Markdown export writes one .md per session. Ignore the common output dir
# names rather than all markdown, which would swallow the docs.
out/
archive/
analytics/
